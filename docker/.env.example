# Allowing python to print() in docker
PYTHONUNBUFFERED=1

COMPOSE_PROJECT_NAME=superset
DEV_MODE=true

# Port configuration (override in .env-local for multiple instances)
# NGINX_PORT=80
# SUPERSET_PORT=8088
# NODE_PORT=9000
# WEBSOCKET_PORT=8080
# CYPRESS_PORT=8081
# DATABASE_PORT=5432
# REDIS_PORT=6379

# database configurations (do not modify)
DATABASE_DB=superset
DATABASE_HOST=db
# IMPORTANT: Change this to a unique secure random value in production
DATABASE_PASSWORD=<change-me-in-production>
DATABASE_USER=superset

# Non-superuser application credentials for RLS enforcement
# The superset_app user is created by docker-entrypoint-initdb.d/01-setup-rls-user.sh
# This user does NOT have SUPERUSER privilege, so RLS policies are enforced
DATABASE_APP_USER=superset_app
DATABASE_APP_PASSWORD=<change-me-in-production>

EXAMPLES_DB=examples
EXAMPLES_HOST=db
EXAMPLES_USER=examples
# IMPORTANT: Change this to a unique secure random value in production
EXAMPLES_PASSWORD=<change-me-in-production>
EXAMPLES_PORT=5432

# database engine specific environment variables
# change the below if you prefer another database engine
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql
POSTGRES_DB=superset
POSTGRES_USER=superset
# IMPORTANT: Change this to a unique secure random value in production
POSTGRES_PASSWORD=<change-me-in-production>
#MYSQL_DATABASE=superset
#MYSQL_USER=superset
#MYSQL_PASSWORD=superset
#MYSQL_RANDOM_ROOT_PASSWORD=yes

# Add the mapped in /app/pythonpath_docker which allows devs to override stuff
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
REDIS_HOST=redis
REDIS_PORT=6379

# Development and logging configuration
# FLASK_DEBUG: Enables Flask dev features (auto-reload, better error pages) - keep 'true' for development
FLASK_DEBUG=true
# SUPERSET_LOG_LEVEL: Controls Superset application logging verbosity (debug, info, warning, error, critical)
SUPERSET_LOG_LEVEL=info

SUPERSET_APP_ROOT="/"
SUPERSET_ENV=development
SUPERSET_LOAD_EXAMPLES=no
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
MAPBOX_API_KEY=''

# IMPORTANT: Change this to a unique secure random value in production
SUPERSET_SECRET_KEY=<change-me-in-production>
ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=true

# =============================================================================
# MULTI-TENANT KEYCLOAK CONFIGURATION
# =============================================================================

# Enable/disable multi-tenant mode
MULTI_TENANT_ENABLED=true

# Keycloak server URL (without trailing slash)
# host.docker.internal works from browser (via /etc/hosts) and containers (Docker provides it)
KEYCLOAK_BASE_URL=http://host.docker.internal:8180

# Base domain for subdomain extraction (e.g., customer1.app.localhost -> customer1)
MULTI_TENANT_BASE_DOMAIN=app.localhost

# Redirect URL when tenant is not found
TENANT_NOT_FOUND_URL=http://localhost:8088/unknown-tenant

# Cache TTL for tenant lookups (seconds)
TENANT_CACHE_TTL=300

# Encryption key for tenant client secrets
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Generate a new key for production!
TENANT_SECRET_ENCRYPTION_KEY=<generate-with-fernet>
